# the repository is the database
GITHUB_REPO=Yoshyaes/growth-desk
GITHUB_BRANCH=main
# fine grained PAT. contents read and write. this repository only.
GITHUB_TOKEN=
GD_STORE=github

# auth. a GitHub OAuth app with callback
# https://<your-deployment>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# fail closed. no allowlist means nobody gets in.
GD_ALLOWED_LOGIN=Yoshyaes

# leave GD_STORE unset (or set it to fs) to run against local files instead
